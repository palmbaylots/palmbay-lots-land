# Space Coast MLS (Spark API) Configuration
# Required for IDX listings integration at /api/idx/listings
SPARK_ACCESS_TOKEN=your_token_here
SPARK_BASE_URL=https://replication.sparkapi.com/Version/3/Reso/OData

# CORS configuration (default: allow all)
# CORS_ORIGINS=http://localhost:3000,https://example.com

# Database (set in Emergent via MongoDB connection)
# MONGODB_URI is auto-set by Emergent — do not override unless custom
